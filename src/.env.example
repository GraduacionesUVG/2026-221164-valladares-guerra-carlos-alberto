# Copia este archivo como .env (desarrollo) o .env.production (producción)
# y reemplaza los valores. NUNCA subas el archivo con valores reales.

# --- Backend (PHP) ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_TTL=3600

# --- Base de datos (MySQL) ---
DB_HOST=db
DB_NAME=trabajograduacion
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# --- Servicio de IA (FastAPI) ---
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TOKEN=cambia-esto-por-un-token-interno
AI_TIMEOUT=60

# --- Configuración del pipeline de IA (opcionales, tienen valor por defecto) ---
OLLAMA_URL=http://localhost:11434
GENERATOR_MODEL=vialbot
BASE_GENERATOR_MODEL=qwen2.5:1.5b
MODELS_DIR=./AI/models
CHROMA_DIR=./AI/data/chroma
TOP_K=7
IN_DOMAIN_THRESHOLD=0.5
